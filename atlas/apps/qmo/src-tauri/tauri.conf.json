{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Qmo",
  "version": "0.1.0",
  "identifier": "xyz.cornna.qmo",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "capabilities": ["local"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "阡陌 Qmo",
    "longDescription": "The 阡陌 Qmo desktop app: the hub's conversation front in a native window, with quick entry, notifications and the tray.",
    "copyright": "Copyright 2026 Qianmo AgentNest Team",
    "publisher": "Qianmo AgentNest Team",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/qmo"],
    "resources": {
      "THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt",
      "../../../../LICENSE": "LICENSE"
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "hardenedRuntime": false
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["qmo"]
      }
    }
  }
}
