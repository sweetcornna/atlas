# 阡陌内测 · 节点 %i 的审计镜像定时器。**这是模板**，见 qianmo-tunnel@.service.in 头注。
#
# 间隔由 QIANMO_BETA_MIRROR_INTERVAL_MIN 定（默认 5 min），它同时决定控制台页头标签里
# 那句「滞后 ≤ N min」—— 两处必须是同一个数，所以两处都从那一个变量派生，不各写一份。

[Unit]
Description=Qianmo beta audit-trail mirror timer for node %i

[Timer]
OnBootSec=2min
OnUnitActiveSec=@MIRROR_INTERVAL_MIN@min
AccuracySec=30s
Unit=qianmo-mirror@%i.service

[Install]
WantedBy=timers.target
